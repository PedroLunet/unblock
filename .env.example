# GitHub OAuth App (optional — omit these to keep the board anonymous-only)
# Create one at https://github.com/settings/developers
# Authorization callback URL (local dev): http://localhost:5173/auth/github/callback
# Authorization callback URL (production): https://<your-domain>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random secret used to encrypt the GitHub session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
